[Unit]
Description=CourseJesus private OpenJev semantic decision service
After=network.target

[Service]
Type=simple
User=coursejev
Group=coursejev
SupplementaryGroups=coursemate
WorkingDirectory=/srv/coursemate/openjev/current
EnvironmentFile=/etc/coursemate/secrets/openjev.env
Environment=OPENJEV_HOST=127.0.0.1
Environment=OPENJEV_PORT=28765
Environment=OPENJEV_QUEUE_LIMIT=8
Environment=OPENJEV_MAX_BODY_BYTES=131072
Environment=OPENJEV_MODEL_PATH=/srv/coursemate/openjev/model/7c79f25b5ac496089f448a969c801872ad59d31c
Environment=OPENJEV_MODEL_MANIFEST=/srv/coursemate/openjev/model/7c79f25b5ac496089f448a969c801872ad59d31c/COURSEJESUS_MODEL_MANIFEST.json
Environment=OPENJEV_CACHE_DIR=/srv/coursemate/openjev/cache
ExecStart=/usr/bin/node src/main.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
Nice=10
CPUWeight=25
MemoryHigh=1650M
MemoryMax=1800M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/srv/coursemate/openjev/cache

[Install]
WantedBy=multi-user.target
