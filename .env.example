# OpenAI — copy this file to .env and add your own key. Never commit .env.
OPENAI_API_KEY=
# Optional. Leave empty for OpenAI's default API; set for an OpenAI-compatible endpoint.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_PROVIDER_MODE=openai

# Preferred V2 provider settings. Each value falls back to the matching OPENAI_*
# variable above when left empty, so existing deployments remain compatible.
RAG_CHAT_API_KEY=
RAG_CHAT_BASE_URL=
RAG_CHAT_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=

# Shared browser/API configuration
WEB_ORIGIN=http://localhost:5173
VITE_RAG_API_URL=http://localhost:8000
VITE_AGENT_API_URL=http://localhost:8001
VITE_CLERK_PUBLISHABLE_KEY=
# V3 navigation remains hidden until the matching backend Schema is enabled and verified.
VITE_V3_ENABLED=false

# Clerk backend verification. Keep secret/private keys on backends only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless Clerk JWT verification.
CLERK_JWT_KEY=
# Comma-separated Clerk user IDs allowed to mutate the shared corpus.
ADMIN_USER_IDS=

# RAG service (paths are relative to services/rag-api)
RAG_DATABASE_PATH=../../data/rag.sqlite3
RAG_UPLOAD_DIR=../../data/uploads
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
MAX_UPLOAD_BYTES=20971520
USER_COURSE_MAX_COURSES=10
USER_COURSE_MAX_FILES=50
USER_COURSE_MAX_TOTAL_UPLOAD_BYTES=524288000
MAX_CONTEXT_CHARS=18000
RAG_QA_REQUESTS_PER_MINUTE=10
APP_ENV=development

# CourseMate V3 learning runtime. Keep disabled during V2-compatible code rollout.
V3_ENABLED=false
V3_MODEL=qwen3.8-max
# Model Studio key and exact regional compatible-mode base URL must be verified by the Owner.
V3_MODEL_API_KEY=
V3_MODEL_BASE_URL=
V3_MAX_OUTPUT_TOKENS=4000
V3_DAILY_OPERATIONS=30
V3_DAILY_MODEL_CALLS_PER_USER=60
V3_DAILY_MODEL_CALLS_PER_USER_COURSE=60
V3_PREVIEW_MAX_BYTES=2097152
V3_PREVIEW_MAX_TEXT_CHARS=100000
V3_PREVIEW_MAX_CSV_ROWS=200
V3_PREVIEW_MAX_CSV_COLUMNS=50
V3_PREVIEW_MAX_CELL_CHARS=2000
V3_PREVIEW_MAX_NOTEBOOK_CELLS=100
V3_PREVIEW_MAX_IMAGE_PIXELS=40000000
V3_PREVIEW_MAX_IMAGE_DIMENSION=16384
V3_OFFICE_MAX_ARCHIVE_ENTRIES=2000
V3_OFFICE_MAX_UNCOMPRESSED_BYTES=52428800
V3_OFFICE_MAX_COMPRESSION_RATIO=100

# Study Agent service (path is relative to services/agent-api)
AGENT_DATABASE_PATH=../../data/agent.sqlite3
AGENT_PORT=8001
AGENT_MAX_TOOL_ROUNDS=4
AGENT_PROVIDER_MODE=openai
AGENT_MODEL_API_KEY=
# For qwen3.8-max use the exact entitled Model Studio compatible-mode endpoint.
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=qwen3.8-max
AGENT_CHAT_REQUESTS_PER_MINUTE=10
AGENT_CHAT_REQUESTS_PER_DAY=30
