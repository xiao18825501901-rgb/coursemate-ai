# CourseMate Laya inference service — environment template.
# Copy to /etc/coursemate/laya.env (root:root, mode 0600) and fill in the secret.

# --- model ---------------------------------------------------------------
LAYA_MODEL_BACKEND=real
LAYA_MODEL_DIR=/srv/coursemate/laya/multilingual
LAYA_MODEL_REPO=convaiinnovations/laya
LAYA_MODEL_SUBFOLDER=multilingual
# Pinned revision; must match the snapshot in LAYA_MODEL_DIR (see manifest).
LAYA_MODEL_REVISION=1c5edc17a7acd8701df6fc341c0d179f1c62c982
LAYA_OFFLINE=true

# --- process -------------------------------------------------------------
LAYA_HOST=127.0.0.1
LAYA_PORT=8105
LAYA_LOG_LEVEL=INFO
LAYA_LOG_FORMAT=json

# --- auth ----------------------------------------------------------------
# Pre-shared service token. MUST be a long random string (generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It is the ONLY credential CourseMate's backend presents. Never a Clerk token.
LAYA_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# --- torch / engine ------------------------------------------------------
# 8 vCPU node: one intra-op thread per vCPU, interop=1 (concurrency=1).
LAYA_TORCH_THREADS=8
LAYA_TORCH_INTEROP_THREADS=1
LAYA_CONCURRENCY=1
LAYA_QUEUE_SIZE=8
LAYA_MAX_DEADLINE_MS=30000

# --- validation / anti-abuse --------------------------------------------
LAYA_MAX_BODY_BYTES=2097152
LAYA_MAX_QUESTIONS=10
LAYA_MAX_OPTIONS_PER_QUESTION=20
LAYA_MAX_REQUEST_TOKENS=8192
LAYA_MAX_LEN=1024
LAYA_HEAD_MAX_LEN=256
LAYA_CALIBRATION_VERSION=none

# --- definitions allowlist ----------------------------------------------
# Server-managed map of (decision_definition_id, definition_version) -> canonical
# question schema. Empty/absent fails closed.
LAYA_DEFINITIONS_PATH=/etc/coursemate/laya-definitions.json
